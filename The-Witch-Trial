local NoclipEnabled = false
local noclipTask

Player:Toggle({
    Title = "Noclip",
    Default = false,
    Callback = function(s)
        NoclipEnabled = s

        if noclipTask then task.cancel(noclipTask) noclipTask = nil end

        if NoclipEnabled then
            local _ncParts = {}
            local _ncChar = nil
            local function _ncRefresh()
                local c = LocalPlayer.Character
                if c == _ncChar and #_ncParts > 0 then return end
                _ncChar = c
                _ncParts = {}
                if c then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") then table.insert(_ncParts, p) end
                    end
                end
            end
            _ncRefresh()
            noclipTask = task.spawn(function()
                while NoclipEnabled do
                    local c = LocalPlayer.Character
                    if c ~= _ncChar then _ncRefresh() end
                    for i = 1, #_ncParts do
                        local p = _ncParts[i]
                        if p and p.Parent and p.CanCollide then p.CanCollide = false end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

local TPWalkSpeed = 1
local TPWalkEnabled = false
local tpWalkTask

Player:Slider({
    Title = "TP Walk Speed",
    Min = 1,
    Max = 10,
    Default = 1,
    Callback = function(v)
        TPWalkSpeed = v
    end
})

Player:Toggle({
    Title = "Enable TP Walk",
    Default = false,
    Callback = function(s)
        TPWalkEnabled = s

        if tpWalkTask then task.cancel(tpWalkTask) tpWalkTask = nil end

        if TPWalkEnabled then
            tpWalkTask = task.spawn(function()
                while TPWalkEnabled do
                    local character = LocalPlayer.Character
                    if character then
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                            hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (TPWalkSpeed * 0.35))
                        end
                    end
                    task.wait(0.03)
                end
            end)
        end
    end
})

local TargetFlySpeed = 16
local FLY_ENABLED = false
local flyTask = nil

Player:Slider({
    Title = "Fly Speed",
    Min = 16,
    Max = 100,
    Default = 16,
    Callback = function(val)
        TargetFlySpeed = val
    end
})

Player:Toggle({
    Title = "Enable Fly",
    Default = false,
    Callback = function(state)
        FLY_ENABLED = state

        if flyTask then task.cancel(flyTask) flyTask = nil end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
        if hrp then
            hrp.Anchored = false
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        if FLY_ENABLED then
            local camera = Workspace.CurrentCamera
            flyTask = task.spawn(function()
                while FLY_ENABLED do
                    local character = LocalPlayer.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if hrp and humanoid then
                        local moveDir = humanoid.MoveDirection
                        if moveDir.Magnitude > 0 then
                            hrp.Anchored = false
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            local cameraCF = camera.CFrame
                            local relativeVector = cameraCF:VectorToObjectSpace(moveDir)
                            local flyDirection = (cameraCF.RightVector * relativeVector.X) + (cameraCF.LookVector * -relativeVector.Z)
                            if flyDirection.Magnitude > 0 then flyDirection = flyDirection.Unit end
                            hrp.CFrame = CFrame.lookAlong(hrp.Position, flyDirection) + (flyDirection * (TargetFlySpeed * 0.03))
                        else
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            hrp.Anchored = true
                        end
                    end
                    task.wait(0.03)
                end
            end)
        end
    end
})

